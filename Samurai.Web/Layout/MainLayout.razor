@inherits LayoutComponentBase

<div class="app-shell">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <header class="site-header">
        <div class="site-header-inner">
            <NavLink href="/" Match="NavLinkMatch.All" class="site-brand" aria-label="SAMURAI, ir al inicio">
                <span class="site-brand-emblem">
                    <img src="images/samurai-logo.svg" alt="" width="48" height="48" />
                </span>
                <span class="site-brand-wordmark">
                    <strong>SAMURAI</strong>
                    <small>EL DOJO DEL CÓDIGO</small>
                </span>
            </NavLink>

            <nav class="site-nav" aria-label="Navegación principal">
                <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                <NavLink href="/estado">Estado técnico</NavLink>
            </nav>

            <span class="site-release" title="Vista técnica de la etapa 2">V2 · BASE TÉCNICA</span>
        </div>
    </header>

    <main id="main-content" class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <span>© SAMURAI · Formación con práctica</span>
            <span>Etapa 02 / 50 <span class="footer-separator">·</span> Sin cuentas ni datos en servidores</span>
        </div>
    </footer>
</div>
